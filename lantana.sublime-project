{
	"build_systems":
	[
		{
			"name": "Dub Run Debug",
			"cmd":
			[
				"dub",
				"run"
			],
			"working_dir": "$project_path"
		},
		{
			"name": "Dub Build Release",
			"cmd":
			[
				"dub",
				"build",
				"--build=release-debug",
				"--parallel"
			],
			"working_dir": "$project_path"
		},
		{
			"name": "Dub Build Release-Ultra",
			"cmd":
			[
				"dub",
				"build",
				"--build=release-ultra",
				"--combined",
				"--parallel"
			],
			"working_dir": "$project_path"
		}
	],
	"folders":
	[
		{
			"path": "."
		},
	]
}
